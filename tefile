# -------------------------------------------------
# Base image
# -------------------------------------------------
FROM kalilinux/kali-rolling

# -------------------------------------------------
# Install core packages
# -------------------------------------------------
RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        systemd systemd-sysv \
        xfce4 xfce4-goodies \
        novnc websockify \
        wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# -------------------------------------------------
# Install RustDesk
# -------------------------------------------------
ARG RUSTDESK_VERSION=1.4.2
RUN wget https://github.com/rustdesk/rustdesk/releases/download/${RUSTDESK_VERSION}/rustdesk-${RUSTDESK_VERSION}-x86_64.deb && \
    dpkg -i rustdesk-${RUSTDESK_VERSION}-x86_64.deb || apt-get -y install -f && \
    rm rustdesk-${RUSTDESK_VERSION}-x86_64.deb

# -------------------------------------------------
# Create required mount points
# -------------------------------------------------
VOLUME ["/sys/fs/cgroup"]

# noVNC will serve the desktop on this port
EXPOSE 6080

# -------------------------------------------------
# Entrypoint script – start systemd and VNC
# -------------------------------------------------
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# -------------------------------------------------
# Default command
# -------------------------------------------------
CMD ["/usr/local/bin/entrypoint.sh"]
