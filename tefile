FROM kalilinux/kali-rolling

# Update package list and install systemd, XFCE, etc.
RUN apt-get update && \
    apt-get install -y systemd systemd-sysv xfce4 xfce4-goodies novnc websockify wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Download and install RustDesk
RUN wget https://github.com/rustdesk/rustdesk/releases/download/1.4.2/rustdesk-1.4.2-x86_64.deb && \
    dpkg -i rustdesk-1.4.2-x86_64.deb || apt-get -y install -f && \
    rm rustdesk-1.4.2-x86_64.deb

# Create a volume for the systemd units
VOLUME [ "/sys/fs/cgroup" ]

# Expose the noVNC web interface port
EXPOSE 6080

# Start systemd and noVNC
CMD ["/lib/systemd/systemd"]
